# Copy to .env.local (git-ignored) and fill in.
# Keys: https://supabase.com/dashboard/project/endbafjcxanzmlwiezwe/settings/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://endbafjcxanzmlwiezwe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Never prefix with NEXT_PUBLIC_, never commit.
# Without it, the backend reads the demo personas with the publishable key and keeps state in memory.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: SUPABASE_URL overrides NEXT_PUBLIC_SUPABASE_URL server-side.
# Optional: BACKEND_OFFLINE=1 forces the offline snapshot + in-memory state (demo without network).

# Kate LLM (T8). Server-side only, never NEXT_PUBLIC_. Without a key Kate uses her deterministic answers.
KATE_LLM_API_KEY=
KATE_LLM_MODEL=gpt-5.6-luna
